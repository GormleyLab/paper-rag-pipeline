# ===========================================
# Paper RAG Pipeline - Environment Variables
# ===========================================

# ----- Required -----

# PostgreSQL Database (with pgvector extension)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/paper_rag

# OpenAI API (for embeddings)
OPENAI_API_KEY=sk-your-api-key-here

# AWS S3 (for PDF storage)
S3_BUCKET=paper-rag-pdfs
AWS_REGION=us-east-1

# ----- Optional -----

# AWS Credentials (not needed if using IAM roles)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# CrossRef API (for polite API usage - recommended)
CROSSREF_EMAIL=your.email@university.edu

# Path to config file (defaults to config/config.yaml)
# CONFIG_PATH=config/config.yaml

# ----- App Runner Deployment -----

# API Key for App Runner authentication (server-side)
# Set this to enable Bearer token authentication
# PAPERRAG_API_KEY=your-api-key-here

# ----- MCP Client Configuration -----

# API Key for connecting to deployed App Runner service (client-side)
# Get this from AWS Secrets Manager: paperrag/api-key
PAPERRAG_API_KEY=your-api-key-from-secrets-manager

# ----- MCP Client Testing (test_paperrag_mcp.py) -----

# Anthropic API Key (for running the MCP Connector test agent)
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
